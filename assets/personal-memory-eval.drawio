        <mxCell id="2" parent="1" style="text;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=10;fontColor=#5E7391;whiteSpace=wrap;html=1;" value="PERSONAL AGENTIC MEMORY  /  RESEARCH MAP" vertex="1">
          <mxGeometry height="20" width="740" x="30" y="19" as="geometry" />
