        <mxCell id="3" parent="1" style="text;strokeColor=none;fillColor=none;fontColor=#172B4D;fontFamily=Arial;fontSize=25;fontStyle=1;whiteSpace=wrap;html=1;" value="02  哪些方法值得优先看？" vertex="1">
          <mxGeometry height="35" width="740" x="30" y="43" as="geometry" />
        </mxCell>
        <mxCell id="4" parent="1" style="text;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=11;fontColor=#526780;whiteSpace=wrap;html=1;" value="以下是各自设置下的报告值；不同骨干、judge、子集和聚合方式之间不作排名。" vertex="1">
          <mxGeometry height="30" width="740" x="30" y="85" as="geometry" />
        </mxCell>
        <mxCell id="5" parent="1" style="text;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=9;fontColor=#64748B;whiteSpace=wrap;html=1;" value="2026-10-28 · 原始论文 / 作者报告 · 研究快照，非统一排行榜 · 点击卡片查看来源" vertex="1">
          <mxGeometry height="20" width="740" x="30" y="568" as="geometry" />
        </mxCell>
        <object label="&lt;b&gt;&lt;font color=&quot;#0A806B&quot;&gt;直接 Personal：RL Agentic Memory&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;PersonaMem-v2 · Qwen3-4B&lt;br&gt;&lt;b&gt;MCQ 55.2% / 开放回答 60.7%&lt;/b&gt;&lt;br&gt;32k 历史 → 2k 可读记忆&lt;br&gt;&lt;br&gt;学习“留什么、如何更新”&lt;br&gt;见原论文 §4.3" link="https://arxiv.org/html/2512.06688v1" id="6">
          <mxCell parent="1" style="rounded=1;arcSize=10;strokeColor=#D9E2EF;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=13;fontColor=#172B4D;fontFamily=Arial;fontSize=12;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="175" width="236" x="30" y="128" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;&lt;font color=&quot;#2265D8&quot;&gt;长期 QA：Hindsight&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;LME-S 91.4% / LoCoMo 89.61%&lt;/b&gt;&lt;br&gt;Gemini-3 Pro 回答配置&lt;br&gt;GPT-OSS-120B judge&lt;br&gt;&lt;br&gt;事实 / 经历 / 信念分层&lt;br&gt;论文历史结果；可作复现基线" link="https://arxiv.org/html/2512.12818v1" id="7">
          <mxCell parent="1" style="rounded=1;arcSize=10;strokeColor=#D9E2EF;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=13;fontColor=#172B4D;fontFamily=Arial;fontSize=12;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="175" width="236" x="282" y="128" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;&lt;font color=&quot;#2265D8&quot;&gt;长期 QA：EverMemOS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;LoCoMo 93.05%&lt;/b&gt;&lt;br&gt;GPT-4.1-mini；三 judge 平均&lt;br&gt;&lt;br&gt;MemCells → MemScenes&lt;br&gt;主题整合 + agentic recall&lt;br&gt;优先比较同表、同骨干增益" link="https://arxiv.org/html/2601.02163v1" id="8">
          <mxCell parent="1" style="rounded=1;arcSize=10;strokeColor=#D9E2EF;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=13;fontColor=#172B4D;fontFamily=Arial;fontSize=12;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="175" width="236" x="534" y="128" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;&lt;font color=&quot;#A46711&quot;&gt;工程：Mastra OM&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;LME-S 94.87%&lt;/b&gt; · GPT-5-mini&lt;br&gt;&lt;b&gt;注意：六类宏平均&lt;/b&gt;&lt;br&gt;GPT-4o judge&lt;br&gt;&lt;br&gt;观察日志 + 后台反思&lt;br&gt;稳定上下文、可缓存" link="https://mastra.ai/research/observational-memory" id="9">
          <mxCell parent="1" style="rounded=1;arcSize=10;strokeColor=#D9E2EF;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=13;fontColor=#172B4D;fontFamily=Arial;fontSize=12;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="175" width="236" x="30" y="318" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;&lt;font color=&quot;#A46711&quot;&gt;工程：Mem0 / Zep&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mem0 自报：&lt;b&gt;92.5% / 94.4%&lt;/b&gt;&lt;br&gt;Zep 自报：&lt;b&gt;94.7% / 90.2%&lt;/b&gt;&lt;br&gt;顺序均为 LoCoMo / LME&lt;br&gt;&lt;br&gt;版本 / 检索预算 / judge 不同&lt;br&gt;Zep 分项与总数待核" link="https://mem0.ai/blog/introducing-temporal-reasoning-in-mem0" id="10">
          <mxCell parent="1" style="rounded=1;arcSize=10;strokeColor=#D9E2EF;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=13;fontColor=#172B4D;fontFamily=Arial;fontSize=12;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="175" width="236" x="282" y="318" as="geometry" />
          </mxCell>
        </object>
        <object label="&lt;b&gt;&lt;font color=&quot;#A46711&quot;&gt;近期高分：Agent Zero&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;LME 95.60% / LoCoMo 93.60%&lt;/b&gt;&lt;br&gt;事件时间线 + 实体图 + 文档记忆&lt;br&gt;&lt;br&gt;作者预印本，分别取最佳配置&lt;br&gt;基线多为历史自报成绩&lt;br&gt;&lt;b&gt;暂不据此宣布统一 SOTA&lt;/b&gt;" link="https://arxiv.org/html/2608.29606v1" id="11">
          <mxCell parent="1" style="rounded=1;arcSize=10;strokeColor=#D9E2EF;fillColor=#FFFFFF;align=left;verticalAlign=top;spacing=13;fontColor=#172B4D;fontFamily=Arial;fontSize=12;whiteSpace=wrap;html=1;" vertex="1">
            <mxGeometry height="175" width="236" x="534" y="318" as="geometry" />
          </mxCell>
        </object>
        <mxCell id="12" parent="1" style="text;strokeColor=none;fillColor=none;fontColor=#172B4D;fontFamily=Arial;fontSize=11;whiteSpace=wrap;html=1;" value="研究对照：A-MEM · MAGMA · Memory-R1  |  10 月新作：AgentMemRec · FlexA-Mem" vertex="1">
          <mxGeometry height="23" width="740" x="30" y="509" as="geometry" />
        </mxCell>
        <mxCell id="13" parent="1" style="text;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=11;fontStyle=1;fontColor=#A34A36;whiteSpace=wrap;html=1;" value="关键：Recall@k ≠ QA accuracy；宏平均 ≠ 逐题准确率；QA 高分 ≠ Personal 任务成功率。" vertex="1">
          <mxGeometry height="22" width="740" x="30" y="537" as="geometry" />
        </mxCell>
      </root>
