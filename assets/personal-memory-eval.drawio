  <diagram id="methods" name="02  哪些方法值得优先看？">
    <mxGraphModel dx="906" dy="993" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="600" background="#F7F9FC" math="0" shadow="0">
      <root>
